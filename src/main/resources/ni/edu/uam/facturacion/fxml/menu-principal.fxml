<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="500.0" prefWidth="700.0" spacing="35.0" styleClass="root-pane" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.facturacion.controller.MenuPrincipalController">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>

    <ImageView fitHeight="100.0" preserveRatio="true" smooth="true">
        <image>
            <Image url="@../images/logo.png" />
        </image>
    </ImageView>

    <VBox alignment="CENTER" spacing="5.0">
        <Label styleClass="titulo-principal" text="Sistema de Facturación" />
        <Label styleClass="subtitulo" text="Proyecto de JavaFX - Programación de Aplicaciones de Escritorio" />
    </VBox>

    <HBox alignment="CENTER" spacing="25.0">
        <Button onAction="#abrirCategorias" styleClass="tarjeta-modulo" text="Gestión de Categorías" />
        <Button onAction="#abrirProductos" styleClass="tarjeta-modulo" text="Gestión de Productos" />
    </HBox>
   <stylesheets>
      <URL value="@menuPrincipal-style.css" />
      <URL value="@../styles/menuPrincipal-style.css" />
   </stylesheets>

</VBox>
