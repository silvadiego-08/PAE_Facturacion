<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="650.0" prefWidth="850.0" spacing="20.0" styleClass="root-pane" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.facturacion.controller.CategoriaController">
    <padding>
        <Insets bottom="30.0" left="35.0" right="35.0" top="30.0" />
    </padding>

    <VBox spacing="4.0" styleClass="header-card">
        <Label styleClass="titulo-vista" text="Gestión de Categorías" />
        <Label styleClass="subtitulo-vista" text="Administre y organice los grupos de productos para facturación" />
    </VBox>

    <VBox spacing="16.0" styleClass="formulario-card">
        <GridPane hgap="15.0" vgap="12.0">
            <columnConstraints>
                <ColumnConstraints halignment="RIGHT" minWidth="90.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="250.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints valignment="CENTER" />
                <RowConstraints valignment="CENTER" />
            </rowConstraints>

            <Label styleClass="campo-label" text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="txtNombre" promptText="Ej. Servicios Informáticos, Papelería..." styleClass="campo-texto" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <CheckBox fx:id="chkActiva" selected="true" styleClass="check-custom" text="Categoría activa para facturar" GridPane.columnIndex="1" GridPane.rowIndex="1" />
        </GridPane>

        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="toolbar-acciones">
            <Button onAction="#guardar" styleClass="btn-primary" text="Guardar">
                <graphic>
                    <ImageView fitHeight="18.0" fitWidth="17.0" preserveRatio="true" smooth="true">
                        <image>
                            <Image url="@../icons/agregar.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>
            <Button onAction="#actualizar" styleClass="btn-secondary" text="Actualizar">
            <graphic>
               <ImageView fitHeight="19.0" fitWidth="15.0" pickOnBounds="true" preserveRatio="true">
                  <image>
                     <Image url="@../icons/actualizar.png" />
                  </image>
               </ImageView>
            </graphic></Button>
            <Button onAction="#limpiar" styleClass="btn-light" text="Limpiar">
            <graphic>
               <ImageView fitHeight="21.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                  <image>
                     <Image url="@../icons/limpiar.png" />
                  </image>
               </ImageView>
            </graphic></Button>
            <Button onAction="#eliminar" styleClass="btn-danger" text="Eliminar">
                <graphic>
                    <ImageView fitHeight="16.0" fitWidth="16.0" preserveRatio="true" smooth="true">
                        <image>
                            <Image url="@../icons/cerrar.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>
            <HBox HBox.hgrow="ALWAYS" />
            <Button onAction="#volver" styleClass="btn-back" text="Volver al Menú" />
        </HBox>
    </VBox>

    <VBox spacing="8.0" styleClass="tabla-card" VBox.vgrow="ALWAYS">
        <Label styleClass="tabla-titulo" text="Categorías Registradas" />
        <TableView fx:id="tablaCategorias" styleClass="tabla-financiera" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" prefWidth="80.0" text="ID" />
                <TableColumn fx:id="colNombre" prefWidth="500.0" text="Nombre de la Categoría" />
                <TableColumn fx:id="colActiva" prefWidth="120.0" text="Estado" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </VBox>
   <stylesheets>
      <URL value="@estilos_categoria.css" />
      <URL value="@../styles/categoria-style.css" />
   </stylesheets>
</VBox>
