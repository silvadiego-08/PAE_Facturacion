<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="720.0" prefWidth="980.0" spacing="20.0" styleClass="root-pane" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.facturacion.controller.ProductoController">
    <padding>
        <Insets bottom="30.0" left="35.0" right="35.0" top="30.0" />
    </padding>

    <VBox spacing="4.0" styleClass="header-card">
        <Label styleClass="titulo-vista" text="Gestión de Productos" />
        <Label styleClass="subtitulo-vista" text="Administración de catálogo, control de existencias y precios de facturación" />
    </VBox>

    <VBox spacing="18.0" styleClass="formulario-card">
        <GridPane hgap="20.0" vgap="14.0">
            <columnConstraints>
                <ColumnConstraints halignment="RIGHT" minWidth="80.0" prefWidth="90.0" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" prefWidth="250.0" />
                <ColumnConstraints halignment="RIGHT" minWidth="90.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" prefWidth="250.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints valignment="CENTER" />
                <RowConstraints valignment="CENTER" />
                <RowConstraints valignment="CENTER" />
                <RowConstraints valignment="CENTER" />
            </rowConstraints>

            <Label styleClass="campo-label" text="Código:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="txtCodigo" promptText="Ej. P001" styleClass="campo-texto" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label styleClass="campo-label" text="Nombre:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
            <TextField fx:id="txtNombre" promptText="Nombre del producto" styleClass="campo-texto" GridPane.columnIndex="3" GridPane.rowIndex="0" />

            <Label styleClass="campo-label" text="Categoría:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <ComboBox fx:id="cmbCategoria" maxWidth="1.1797693134862315E308" promptText="Seleccione una categoría" styleClass="campo-combo" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label styleClass="campo-label" text="Precio (C$):" GridPane.columnIndex="2" GridPane.rowIndex="1" />
            <TextField fx:id="txtPrecio" promptText="0.00" styleClass="campo-texto" GridPane.columnIndex="3" GridPane.rowIndex="1" />

            <Label styleClass="campo-label" text="Existencia:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <TextField fx:id="txtExistencia" promptText="0" styleClass="campo-texto" GridPane.columnIndex="1" GridPane.rowIndex="2" />

            <Label styleClass="campo-label" text="Ruta imagen:" GridPane.columnIndex="2" GridPane.rowIndex="2" />

            <CheckBox fx:id="chkActivo" selected="true" styleClass="check-custom" text="Producto disponible para venta" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="3" />
            <HBox alignment="CENTER_LEFT" spacing="8.0" GridPane.columnIndex="3" GridPane.rowIndex="2">
                <TextField fx:id="txtRutaImagen" editable="false" promptText="Sin imagen seleccionada" styleClass="campo-texto" HBox.hgrow="ALWAYS" />
                <Button fx:id="btnImagen" mnemonicParsing="false" onAction="#seleccionarImagen" styleClass="btn-imagen" text="📁  Examinar..." />
            </HBox>
        </GridPane>

        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="toolbar-acciones">
            <Button onAction="#guardar" prefHeight="35.0" prefWidth="113.0" styleClass="btn-primary" text="Guardar">
                <graphic>
                    <ImageView fitHeight="20.0" fitWidth="19.0" preserveRatio="true" smooth="true">
                        <image>
                            <Image url="@../icons/agregar.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>
            <Button onAction="#actualizar" styleClass="btn-secondary" text="Actualizar">
            <graphic>
               <ImageView fitHeight="17.0" fitWidth="28.0" pickOnBounds="true" preserveRatio="true">
                  <image>
                     <Image url="@../icons/actualizar.png" />
                  </image></ImageView>
            </graphic></Button>
            <Button onAction="#limpiar" styleClass="btn-light" text="Limpiar">
            <graphic>
               <ImageView fitHeight="19.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true">
                  <image>
                     <Image url="@../icons/limpiar.png" />
                  </image>
               </ImageView>
            </graphic></Button>
            <Button onAction="#eliminar" styleClass="btn-danger" text="Eliminar">
                <graphic>
                    <ImageView fitHeight="16.0" fitWidth="16.0" preserveRatio="true" smooth="true">
                        <image>
                            <Image url="@../icons/cerrar.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>
            <HBox HBox.hgrow="ALWAYS" />
            <Button onAction="#volver" styleClass="btn-back" text="Volver al Menú" />
        </HBox>
    </VBox>

    <VBox spacing="12.0" styleClass="tabla-card" VBox.vgrow="ALWAYS">
        <Label styleClass="tabla-titulo" text="Catálogo de Productos Registrados" />

        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <TextField fx:id="txtBuscar" promptText="Buscar por código o nombre..." styleClass="campo-texto" HBox.hgrow="ALWAYS" />
            <Button onAction="#buscar" styleClass="btn-primary" text="Buscar" />
            <Button onAction="#verTodos" styleClass="btn-light" text="Ver todos" />
        </HBox>

        <TableView fx:id="tablaProductos" styleClass="tabla-financiera" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
                <TableColumn fx:id="colCodigo" prefWidth="100.0" text="Código" />
                <TableColumn fx:id="colNombre" prefWidth="250.0" text="Nombre" />
                <TableColumn fx:id="colCategoria" prefWidth="160.0" text="Categoría" />
                <TableColumn fx:id="colPrecio" prefWidth="110.0" text="Precio" />
                <TableColumn fx:id="colExistencia" prefWidth="100.0" text="Existencia" />
                <TableColumn fx:id="colActivo" prefWidth="90.0" text="Estado" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </VBox>
    <stylesheets>
        <URL value="@../styles/producto-style.css" />
    </stylesheets>
</VBox>
